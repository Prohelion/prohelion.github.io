{
  "name": "profinity-docs-scripts",
  "version": "1.0.0",
  "description": "Scripts for validating and processing Profinity documentation",
  "private": true,
  "scripts": {
    "validate-dashboards": "node validate-dashboard-examples.js",
    "validate-schema": "node validate-dashboard-examples.js --schema-only",
    "validate": "node validate-dashboard-examples.js",
    "verify-2.3-urls": "node verify-2.3-doc-urls.js",
    "update-2.3-checklist": "node verify-2.3-doc-urls.js -- --update-checklist",
    "validate-dashboards:all": "node validate-dashboard-examples.js --recursive",
    "lint-docs": "node lint-docs.js",
    "test-lint": "node --test lint-docs.test.js review-pages.test.js",
    "review-prepass": "node review-pages.js prepass",
    "review-phrasing": "node review-pages.js phrasing",
    "review-apply-phrasing": "node review-pages.js apply-phrasing",
    "review-score": "node review-pages.js score",
    "generate-llms": "node generate-llms-txt.js"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "yaml": "^2.3.4"
  }
}
